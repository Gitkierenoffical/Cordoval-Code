{
  "name": "cordoval-code",
  "productName": "Cordoval Code",
  "version": "0.4.0",
  "description": "Cordoval Code - privacy-first desktop AI coding app",
  "main": "src/main/main.js",
  "author": "Cordoval",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:msix": "bash scripts/build-msix.sh"
  },
  "build": {
    "appId": "app.cordoval.code",
    "productName": "Cordoval Code",
    "files": [
      "src/**",
      "assets/**",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "node_modules/typescript/**",
      "node_modules/typescript-language-server/**",
      "node_modules/pyright/**"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cordoval Code"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/cordoval-code"
      }
    ],
    "appx": {
      "identityName": "Cordoval.CordovalCode",
      "publisher": "CN=Cordoval",
      "publisherDisplayName": "Cordoval",
      "displayName": "Cordoval Code",
      "applicationId": "CordovalCode",
      "backgroundColor": "transparent",
      "languages": [
        "en-GB"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "marked": "^18.1.1",
    "monaco-editor": "^0.52.2",
    "pyright": "^1.1.414",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2"
  }
}
