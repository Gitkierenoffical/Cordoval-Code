{
  "name": "cordoval-code",
  "productName": "Cordoval Code",
  "version": "0.1.0",
  "description": "Cordoval Code - privacy-first desktop AI coding app",
  "main": "src/main/main.js",
  "author": "Cordoval",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "app.cordoval.code",
    "productName": "Cordoval Code",
    "files": [
      "src/**",
      "assets/**",
      "LICENSE",
      "NOTICE.md"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cordoval Code"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "marked": "^18.1.1"
  }
}